# Public analytics IDs (safe in the browser; still keep out of git via .env*)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_PROJECT_ID=xxxxxxxxxx

# Server-only contact form email. Do not prefix these with NEXT_PUBLIC_.
# The site builds without them. Until they are set, the form tells the visitor
# to email the firm and the server logs the missing configuration.
RESEND_API_KEY=
# Address on the domain you verify in Resend, for example:
# CONTACT_FROM_EMAIL=Benford Consulting <consultations@benfordcpa.com>
CONTACT_FROM_EMAIL=
# Optional. Defaults to kolby@benfordcpa.com
CONTACT_TO_EMAIL=kolby@benfordcpa.com
